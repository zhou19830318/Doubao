#pragma once

#define SECRETS_WIFI_SSID     "xxx"
#define SECRETS_WIFI_PASSWORD "xxx"

/* Doubao realtime voice API key (X-Api-Key request header).
 * Get it from the Volcengine console; after Task 6b it is configured via
 * the webserver settings page and this file only holds the default. */
#define SECRETS_DOUBAO_API_KEY "<your-api-key>"

/* O2.0 binary protocol credentials (singing feature, optional). */
#define SECRETS_O20_APP_ID     "<your-app-id>"
#define SECRETS_O20_ACCESS_KEY "<your-access-key>"
